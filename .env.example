# Get these from https://www.patreon.com/portal/registration/register-clients
PATREON_CLIENT_ID=your_client_id_here
PATREON_CLIENT_SECRET=your_client_secret_here

# Local dev only — register this exact URI in the Patreon developer portal
PATREON_REDIRECT_URI=http://localhost:3001/api/auth/patreon/callback
FRONTEND_URL=http://localhost:5173

# On Vercel, set only PATREON_CLIENT_ID and PATREON_CLIENT_SECRET.
# The redirect URI and frontend URL are auto-detected from the request.
